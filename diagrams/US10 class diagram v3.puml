    class RestExtractionPanel {
        - showFullBody: boolean = false
        --
        + RestExtractionPanel(extractor: RestExtractor)
        + callRecorded(ns: ApiNamespace): void
        - onAddNamespace(): void
        - onAddEndpoint(): void
        - onStartStop(): void
        - onRemove(): void
        - onClear(): void
        - onSelectNamespace(): void
        - onSelectCall(): void
        - onToggleFullBody(): void
        - onFilter(): void
        - showReport(ns: ApiNamespace): void
        - showCalls(report: ApiReport): void
    }
    class CallTableModel {
        - rows: List<Row>
        --
        + setEndpoints(endpoints: List<EndpointReport>): void
        + getCallAt(row: int): RecordedCall
        + rowOf(call: RecordedCall): int
        + matches(row: int, method: HttpMethod, text: String): boolean
        + getRowCount(): int
        + getColumnCount(): int
        + getColumnName(column: int): String
        + getColumnClass(column: int): Class<?>
        + getValueAt(row: int, column: int): Object
    }
    class ApiDocumentationWriter {
        + write(report: ApiReport): String
        + formatBody(responseHeaders: String, body: String): String
        - writeEndpoint(endpoint: EndpointReport): String
        - writeValues(endpoint: EndpointReport): String
        - writeCall(call: RecordedCall): String
        - escape(text: String): String
    }
}

note as N_ApiDocumentationWriter
    **ApiDocumentationWriter**
    * Per endpoint: the count per method and the values seen per variable.
      Per call: method, status code, arguments and the response headers. No bodies (D15).
    * ""formatBody"" gives the body of one call for the detail view of the panel,
      indented when it is JSON. The panel only asks for it when Full body is ticked.
    * Every value from traffic goes through ""escape"" before it goes into the HTML,
      so a ""<script>"" in a response is shown as text and never runs.
    * The panel passes ""ns"" and the ""ApiReport"" on as parameters only
      (those dependencies are not drawn).
end note

note as N_CallTableModel
    **CallTableModel** (the rows of the Calls table)

    One row per call: time, method, status code, endpoint and arguments. The calls of
    several endpoints are merged by time. ""setEndpoints"" only reports the new rows when
    the old ones did not change, so the selection and scroll position stay.
    ""matches"" is the filter on method and text (ignoring case) behind the panel's row
    filter. ""Row"" is a private pair of template and ""RecordedCall"".
end note

