' ============================================================ Domain
package "Domain layer, controller at its border (org.zaproxy.addon.restextraction.model): no ZAP or Swing imports" as model {
    class RestExtractor {
        + addNamespace(baseUrl: String): ApiNamespace
        + addEndpoint(ns: ApiNamespace, template: String): Endpoint
        + removeNamespace(ns: ApiNamespace): void
        + removeEndpoint(ns: ApiNamespace, template: String): void
        + clear(ns: ApiNamespace): void
        + clearEndpoint(ns: ApiNamespace, template: String): void
        + startExtraction(ns: ApiNamespace): void
        + stopExtraction(ns: ApiNamespace): void
        + record(call: ApiCall): void
        + getReport(ns: ApiNamespace): ApiReport
        + addObserver(observer: ExtractionObserver): void
    }
    interface ExtractionObserver <<interface>> {
        + callRecorded(ns: ApiNamespace): void
    }
    class ApiNamespace {
        - baseUrl: String
        - scheme: String
        - host: String
        - port: int
        - extracting: boolean
        --
        + ApiNamespace(baseUrl: String)
        + getBaseUrl(): String
        + isExtracting(): boolean
        + addEndpoint(template: String): Endpoint
        + removeEndpoint(template: String): void
        + start(): void
        + stop(): void
        + record(call: ApiCall): boolean
        + clear(): void
        + clearEndpoint(template: String): void
        + createReport(): ApiReport
        - sameOrigin(url: URI): boolean
    }
    class Endpoint {
        + Endpoint(template: String)
        + getTemplate(): String
        + record(call: ApiCall, path: UrlPath): boolean
        + clear(): void
        + createReport(): EndpointReport
        - {static} countCalls(calls: List<RecordedCall>, method: HttpMethod): int
    }
    class EndpointPattern {
        - template: String
        --
        + EndpointPattern(template: String)
        + matches(path: UrlPath): boolean
        + argumentsOf(path: UrlPath): Map<String, String>
        + getTemplate(): String
    }
    abstract class PathSegment <<abstract>> {
        ~ {abstract} matches(part: String): boolean <U+007B>abstract}
        ~ addArgument(part: String, args: Map<String, String>): void
    }
    class LiteralSegment {
        - text: String
        --
        ~ LiteralSegment(text: String)
        ~ matches(part: String): boolean
    }
    class VariableSegment {
        - name: String
        --
        ~ VariableSegment(name: String)
        ~ matches(part: String): boolean
        ~ addArgument(part: String, args: Map<String, String>): void
    }
    class UrlPath {
        - parts: List<String>
        --
        + UrlPath(path: String)
        + startsWith(prefix: UrlPath): boolean
        + after(prefix: UrlPath): UrlPath
        + size(): int
        + part(index: int): String
    }
    class ApiReport {
        - baseUrl: String
        --
        + ApiReport(baseUrl: String, endpoints: List<EndpointReport>)
        + getBaseUrl(): String
        + getEndpoints(): List<EndpointReport>
    }
    class EndpointReport {
        - template: String
        - callCounts: Map<HttpMethod, Integer>
        - valuesSeen: Map<String, Map<String, Integer>>
        --
        + EndpointReport(template: String, callCounts: Map<HttpMethod, Integer>, calls: List<RecordedCall>)
        + getTemplate(): String
        + getCallCounts(): Map<HttpMethod, Integer>
        + getCalls(): List<RecordedCall>
        + getValuesSeen(): Map<String, Map<String, Integer>>
    }
    class RecordedCall {
        - arguments: Map<String, String>
        --
        + RecordedCall(call: ApiCall, arguments: Map<String, String>)
        + getCall(): ApiCall
        + getArguments(): Map<String, String>
    }
    class ApiCall {
        - method: HttpMethod
        - url: String
        - statusCode: int
        - responseHeaders: String
        - responseBody: String
        - time: Instant = Instant.now()
        --
        + ApiCall(method: HttpMethod, url: String, statusCode: int, responseHeaders: String, responseBody: String)
        + getMethod(): HttpMethod
        + getUrl(): String
        + getStatusCode(): int
        + getResponseHeaders(): String
        + getResponseBody(): String
        + getTime(): Instant
    }
    enum HttpMethod <<enumeration>> {
        GET
        POST
        PUT
        DELETE
        PATCH
        HEAD
        OPTIONS
        OTHER
        --
        + {static} fromString(name: String): HttpMethod
    }
}

note as N_RestExtractor
    **RestExtractor** (facade controller: only delegates)

    ""record(call):""
    ""  forall ns in namespaces:""
    ""    if ns.record(call):""
    ""      forall o in observers: o.callRecorded(ns)""
    ""getReport(ns): return ns.createReport()""
    ""removeNamespace(ns): namespaces.remove(ns); ns.stop()""

    Remove and clear are passed on to the namespace the same way.
end note

note as N_ApiNamespace
    **ApiNamespace** (Expert for origin and base path; both are checked only here)

    ""ApiNamespace(baseUrl):""
    ""  store it normalised: lower-case host, default""
    ""  port filled in, no trailing slash""
    ""  basePath = new UrlPath(path of baseUrl)""
    ""record(call):""
    ""  if not extracting: return false""
    ""  url = URI of call.getUrl()""
    ""  if not sameOrigin(url): return false""
    ""  path = new UrlPath(raw path of url)""
    ""  if not path.startsWith(basePath): return false""
    ""  rest = path.after(basePath)""
    ""  recorded = false""
    ""  forall e in endpoints:""
    ""    recorded = e.record(call, rest) or recorded""
    ""  return recorded""

    ""sameOrigin"": scheme equal, host equal ignoring case, port equal with 443/80 filled in.
    ""removeEndpoint"", ""clearEndpoint"": ""/posts"" and ""/posts/"" are the same endpoint.
    ""clear"" forgets the calls and keeps the endpoints and the running state.
    All rules: US10 design, section 3.
end note

note as N_Endpoint
    **Endpoint** (facade over its pattern and its calls)

    ""record(call, path):""
    ""  if not pattern.matches(path): return false""
    ""  calls.add(new RecordedCall(call,""
    ""                pattern.argumentsOf(path)))""
    ""  return true""
    ""clear(): calls.clear()  // reports made before keep theirs""
    ""createReport():""
    ""  return new EndpointReport(pattern.getTemplate(),""
    ""    countCalls per method used, copy of calls)""

    ""path"" is already the part after the base path. Arguments are computed
    once, when the call is recorded.
end note

note as N_EndpointPattern
    **EndpointPattern** (the matcher: only the path after the base path)

    ""EndpointPattern(template):   // "/posts/[POST_ID]/comments"""
    ""  forall part in new UrlPath(template):""
    ""    [NAME] -> VariableSegment(NAME)""
    ""    else   -> LiteralSegment(part)""
    ""matches(path):""
    ""  return path.size() == segments.size""
    ""     and forall i: segments[i].matches(path.part(i))""
    ""argumentsOf(path):""
    ""  forall i: segments[i].addArgument(path.part(i), args)""
    ""  return args""

    The only ""[ ]"" check (Creator). Refused: no leading ""/"", ""[ ]"" inside a part,
    the same ""[NAME]"" twice.
end note

note as N_UrlPath
    **UrlPath** (immutable value object, Pure Fabrication): the one place for the
    path rules, used for the base path, the templates and every request.

    ""UrlPath(path):""
    ""  drop one trailing "/", split on "/",""
    ""  decode each part (%20 -> space)""
    ""startsWith(prefix): first prefix.size() parts equal""
    ""after(prefix):      new UrlPath of the remaining parts""

    It only reads text; deciding (covers, matches) stays with the namespace and the pattern.
end note

note as N_LiteralSegment
    **Segments**: no type check while matching. Package-private: only ""EndpointPattern"" uses them.

    ""LiteralSegment.matches(p):  return text.equals(p)""
    ""VariableSegment.matches(p): return not p.isEmpty()""
    ""PathSegment.addArgument(p, args): nothing""
    ""VariableSegment.addArgument(p, args):""
    ""  args.put(name, p)""
end note

note as N_ApiReport
    **ApiReport, EndpointReport**: the output of the domain, an immutable snapshot
    (lists are copied), built by the experts on request. The writer never touches
    live domain objects, and it reads one consistent state while proxy threads keep
    recording. ""RecordedCall"" and ""ApiCall"" are immutable too, so the snapshot
    can share them. ""EndpointReport"" counts the values seen per variable once, when
    it is made (D16), e.g. ""POST_ID={1=3, abcd=1}"".
end note

